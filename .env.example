# Copy to .env (gitignored) and fill in.

# One OpenCode key for the whole project: the research pipeline and the API server's /api/ask both use it.
OPENCODE_API_KEY=

# Role 1 research pipeline only.
TAVILY_API_KEY=
JINA_API_KEY=

# Role 2 API server: where /api/ask sends Claude requests (OpenCode's Anthropic-compatible endpoint).
ANTHROPIC_BASE_URL=https://opencode.ai/inference/anthropic
# Optional: a separate key for /api/ask. Leave empty to reuse OPENCODE_API_KEY.
ANTHROPIC_API_KEY=
